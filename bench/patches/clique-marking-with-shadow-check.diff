+    auto markClique = [&](HighsInt cliqueid) {
+      for (HighsInt k = cliques[cliqueid].start; k != cliques[cliqueid].end;
+           ++k)
+        if (!colDeleted[cliqueentries[k].col])
+          mark[cliqueentries[k].index()] = stamp;
+    };
+    invertedHashList[v.index()].for_each(markClique);
+    invertedHashListSizeTwo[v.index()].for_each(markClique);
+    // a pairwise query of v with itself only finds a common clique among the
+    // cliques that are not of size two
+    // haveCommonClique is false for two literals of the same column
+    mark[v.index()] = 0;
+    mark[v.complement().index()] = 0;
+    for (HighsInt i = 0; i < N; ++i)
+      if (mark[q[i].index()] == stamp) neighbourhoodInds.push_back(i);
+#ifdef HIGHS_LAB_SHADOW_CHECK
+    {
+      int64_t dummy = 0;
+      std::vector<HighsInt> ref;
+      for (HighsInt i = 0; i < N; ++i)
+        if (haveCommonClique(dummy, v, q[i])) ref.push_back(i);
+      if (ref != neighbourhoodInds) {
+        fprintf(stderr, "SHADOW MISMATCH v=%d/%d N=%d mark=%d pair=%d\n",
+                (int)v.col, (int)v.val, (int)N, (int)neighbourhoodInds.size(),
+                (int)ref.size());
+        for (HighsInt i : neighbourhoodInds) {
+          if (std::find(ref.begin(), ref.end(), i) != ref.end()) continue;
+          CliqueVar u = q[i];
+          fprintf(stderr, "  extra u=%d/%d same_col=%d deleted=%d ncl(u)=%d\n",
+                  (int)u.col, (int)u.val, (int)(u.col == v.col),
+                  (int)colDeleted[u.col], (int)numCliques(u));
+          auto show = [&](HighsInt c, const char* kind) {
+            bool inU = false;
+            for (HighsInt k = cliques[c].start; k != cliques[c].end; ++k)
+              if (cliqueentries[k] == u) inU = true;
+            if (inU)
+              fprintf(stderr, "   fc(v,u)=%p fc(u,v)=%p vContains=%d emptyV=%d emptyU=%d\n",
+                      (const void*)invertedHashList[v.index()].find_common(invertedHashList[u.index()]),
+                      (const void*)invertedHashList[u.index()].find_common(invertedHashList[v.index()]),
+                      (int)invertedHashList[v.index()].contains(c),
+                      (int)invertedHashList[v.index()].empty(), (int)invertedHashList[u.index()].empty());
+            if (inU)
+              fprintf(stderr, "   via %s clique %d len=%d linkedU=%d linkedU2=%d\n", kind,
+                      (int)c, (int)(cliques[c].end - cliques[c].start),
+                      (int)invertedHashList[u.index()].contains(c),
+                      (int)invertedHashListSizeTwo[u.index()].contains(c));
+          };
+          invertedHashList[v.index()].for_each([&](HighsInt c) { show(c, "big"); });
+          invertedHashListSizeTwo[v.index()].for_each([&](HighsInt c) { show(c, "two"); });
+        }
+        abort();
+      }
+      static int64_t nchecked = 0;
+      if ((++nchecked & 0xfffff) == 0)
+        fprintf(stderr, "SHADOW ok %ld\n", (long)nchecked);
+    }
+#endif
+    numQueries += N;
+    return;
+  }
